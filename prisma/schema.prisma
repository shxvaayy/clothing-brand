generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ AUTH / USERS ============

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  ORDER_MANAGER
  INVENTORY_MANAGER
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(ADMIN)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  passwordHash String
  createdAt    DateTime   @default(now())
  addresses    Address[]
  orders       Order[]
  wishlist     WishlistItem[]
  cart         Cart?
  reviews      Review[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============ CATALOG ============

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  seoTitle    String?
  seoDescription String?
  products    Product[]
  createdAt   DateTime   @default(now())
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  published   Boolean   @default(true)
  sortOrder   Int       @default(0)
  seoTitle    String?
  seoDescription String?
  products    ProductCollection[]
  createdAt   DateTime  @default(now())
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  description      String
  shortDescription String?
  fabric           String?
  fit              String?
  care             String?
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  bestSeller       Boolean       @default(false)
  newArrival       Boolean       @default(false)
  onSale           Boolean       @default(false)
  mrp              Int // paise
  sellingPrice     Int // paise
  costPrice        Int?
  lowStockThreshold Int          @default(5)
  tags             String[]      @default([])
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  canonicalUrl     String?
  draftData        Json? // pending edits on a published product; applied on Publish
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images      ProductImage[]
  variants    ProductVariant[]
  collections ProductCollection[]
  reviews     Review[]
  orderItems  OrderItem[]
  wishlistedBy WishlistItem[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([bestSeller])
  @@index([newArrival])
  @@index([onSale])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String  @unique
  size          String
  color         String
  colorHex      String?
  priceOverride Int?
  stock         Int     @default(0)
  reservedStock Int     @default(0)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())

  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryTxns InventoryTransaction[]

  @@unique([productId, size, color])
  @@index([productId])
}

enum InventoryReason {
  RESTOCK
  MANUAL_ADJUST
  SALE
  CANCELLATION
  RETURN
  RESERVATION_RELEASE
  CORRECTION
}

model InventoryTransaction {
  id        String          @id @default(cuid())
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  previous  Int
  next      Int
  reason    InventoryReason
  note      String?
  actor     String? // admin email or "system"
  orderId   String?
  createdAt DateTime        @default(now())

  @@index([variantId, createdAt])
}

// ============ CART / WISHLIST ============

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String     @unique @default(cuid()) // anonymous cart cookie token
  items     CartItem[]
  couponCode String?
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model WishlistItem {
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

// ============ COUPONS ============

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int // percent (1-100) or paise
  minCartValue  Int        @default(0)
  maxDiscount   Int? // paise cap for percent coupons
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  perUserLimit  Int?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  redemptions   CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  userId    String?
  amount    Int
  createdAt DateTime @default(now())

  @@index([couponId, userId])
}

// ============ ORDERS / PAYMENTS ============

enum OrderStatus {
  PAYMENT_PENDING
  PAID
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  guestEmail    String?
  guestPhone    String?
  status        OrderStatus @default(PAYMENT_PENDING)
  subtotal      Int // sum of selling prices, paise
  mrpTotal      Int
  discount      Int         @default(0) // coupon discount
  couponCode    String?
  shippingFee   Int         @default(0)
  total         Int
  addressSnapshot Json
  reservationExpiresAt DateTime?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items    OrderItem[]
  payment  Payment?
  shipment Shipment?
  events   OrderEvent[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?       @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  name       String
  image      String?
  size       String
  color      String
  sku        String
  mrp        Int
  price      Int // unit selling price, paise
  quantity   Int

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING
  REFUNDED
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         String        @default("RAZORPAY")
  razorpayOrderId  String?       @unique
  razorpayPaymentId String?
  signature        String?
  method           String?
  status           PaymentStatus @default(CREATED)
  amount           Int
  currency         String        @default("INR")
  refundedAmount   Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

// ============ SHIPPING / DELIVERY ============

model Shipment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String          @default("MOCK")
  awb            String?
  labelUrl       String?
  trackingUrl    String?
  status         String          @default("PENDING")
  estimatedDelivery DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         ShipmentEvent[]
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([shipmentId, createdAt])
}

// ============ REVIEWS ============

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String?
  verified  Boolean      @default(false)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([productId, userId])
  @@index([productId, status])
}

// ============ CMS ============

enum SectionType {
  ANNOUNCEMENT
  HERO
  PRODUCT_GRID
  CATEGORY_GRID
  COLLECTION_BANNER
  BRAND_STORY
  NEWSLETTER
  FAQ_PREVIEW
}

model HomepageSection {
  id        String      @id @default(cuid())
  type      SectionType
  title     String?
  subtitle  String?
  config    Json // section-specific settings (image, cta, collectionSlug, productIds, count, source...)
  sortOrder Int         @default(0)
  published Boolean     @default(true)
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String // markdown
  seoTitle  String?
  seoDescription String?
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ============ AUDIT / SETTINGS ============

model AuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id])
  actor     String // email snapshot
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ============ LEADS / ANALYTICS ============

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  FOLLOW_UP
  CONVERTED
  LOST
  UNQUALIFIED
}

model Lead {
  id           String     @id @default(cuid())
  name         String?
  email        String?
  phone        String?
  country      String?
  source       String // NEWSLETTER, CONTACT_FORM, ABANDONED_CHECKOUT, ...
  campaign     String?
  landingPage  String?
  productInterest String?
  message      String?
  status       LeadStatus @default(NEW)
  notes        String?
  convertedOrderId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String // page_view, product_view, add_to_cart, search, checkout_started, purchase...
  visitorId  String
  sessionId  String
  userId     String?
  path       String?
  productId  String?
  categoryId String?
  query      String?
  meta       Json?
  country    String?
  device     String? // mobile | desktop | tablet
  browser    String?
  os         String?
  referrer   String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([visitorId, createdAt])
  @@index([productId, type])
  @@index([createdAt])
}

model DailyMetric {
  date        DateTime @id @db.Date
  visitors    Int      @default(0)
  sessions    Int      @default(0)
  pageViews   Int      @default(0)
  productViews Int     @default(0)
  addToCarts  Int      @default(0)
  checkouts   Int      @default(0)
  orders      Int      @default(0)
  revenue     Int      @default(0) // paise, paid orders
  units       Int      @default(0)
  updatedAt   DateTime @updatedAt
}
