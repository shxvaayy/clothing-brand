# ============ Rare Naari — environment template ============
# Copy to .env for local dev. On Render, add these in the dashboard.

# --- Required everywhere ---
DATABASE_URL="postgresql://user:password@host:5432/rare_naari"
NEXT_PUBLIC_APP_URL="https://www.rarenaari.com"
AUTH_SECRET="generate-a-long-random-string"   # e.g. `openssl rand -hex 32`

# --- Razorpay (client will provide; without these, local dev simulates payments) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""   # set the webhook in Razorpay dashboard to <APP_URL>/api/webhooks/razorpay

# --- Transactional email (business mailbox SMTP) ---
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="Rare Naari <care@rarenaari.com>"

# --- Delivery partner (add when finalized; "mock" only works outside production) ---
DELIVERY_PROVIDER="mock"
DELIVERY_API_KEY=""
DELIVERY_API_SECRET=""
DELIVERY_ACCOUNT_ID=""
DELIVERY_WEBHOOK_SECRET=""

# --- Optional analytics ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
